<phone:PhoneApplicationPage
    x:Class="J2MEWP81.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="12,17,0,12">
            <TextBlock x:Name="GameTitle" Style="{StaticResource PhoneTextNormalStyle}" />
            <TextBlock Text="settings" Margin="9,-7,0,0" Style="{StaticResource PhoneTextTitle1Style}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="12,0,12,0">
            <StackPanel>
                <TextBlock Text="Game screen size (width x height)" Style="{StaticResource PhoneTextSubtleStyle}" />
                <ListBox x:Name="SizeList" Height="210" SelectionChanged="SizeList_SelectionChanged" Margin="12,0,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" FontSize="26" Margin="0,4" /></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="WidthBox" Width="140" InputScope="Number" />
                    <TextBlock Text="x" VerticalAlignment="Center" FontSize="26" />
                    <TextBox x:Name="HeightBox" Width="140" InputScope="Number" />
                </StackPanel>

                <TextBlock Text="Orientation" Style="{StaticResource PhoneTextSubtleStyle}" Margin="12,12,0,0" />
                <RadioButton x:Name="OrientDefault" Content="Follow the phone" GroupName="orient" />
                <RadioButton x:Name="OrientPortrait" Content="Portrait" GroupName="orient" />
                <RadioButton x:Name="OrientLandscape" Content="Landscape" GroupName="orient" />

                <TextBlock x:Name="ScaleLabel" Style="{StaticResource PhoneTextSubtleStyle}" Margin="12,12,0,0" />
                <Slider x:Name="ScaleSlider" Minimum="30" Maximum="100" SmallChange="5" LargeChange="10" ValueChanged="ScaleSlider_ValueChanged" />
                <CheckBox x:Name="StretchBox" Content="Stretch to fill (ignore aspect ratio)" />
                <CheckBox x:Name="KeypadBox" Content="Show on-screen keypad" />
                <CheckBox x:Name="FpsBox" Content="Show FPS" />

                <TextBlock Text="Java heap (applies on next start)" Style="{StaticResource PhoneTextSubtleStyle}" Margin="12,12,0,0" />
                <RadioButton x:Name="Heap64" Content="64 MB" GroupName="heap" />
                <RadioButton x:Name="Heap96" Content="96 MB" GroupName="heap" />
                <RadioButton x:Name="Heap128" Content="128 MB" GroupName="heap" Margin="0,0,0,24" />
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar IsVisible="True">
            <shell:ApplicationBarIconButton IconUri="/Assets/AppBar/check.png" Text="save" Click="Save_Click" />
            <shell:ApplicationBarIconButton IconUri="/Assets/AppBar/cancel.png" Text="cancel" Click="Cancel_Click" />
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>
</phone:PhoneApplicationPage>
