<Page
    x:Class="J2MEW10M.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">
    <Page.Resources>
        <Style x:Key="PadKey" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- Game menu: shared by the pad's menu key, the floating menu button (keypad hidden)
             and the Back button. -->
        <MenuFlyout x:Key="GameMenu" Opening="GameMenu_Opening">
            <MenuFlyoutItem Text="Game settings" Click="MenuSettings_Click"/>
            <MenuFlyoutItem Text="Hide keypad" Tag="keypad" Click="MenuKeypad_Click"/>
            <MenuFlyoutItem Text="Move keypad" Tag="movepad" Click="MenuMovePad_Click"/>
            <MenuFlyoutItem Text="Restart game" Click="MenuRestart_Click"/>
            <MenuFlyoutItem Text="Game list" Click="MenuList_Click"/>
        </MenuFlyout>
    </Page.Resources>

    <!--
      Layout (switched in code by window aspect, see MainPage::ApplyLayout):
        landscape: [LeftPad | Lcd | RightPad]   (columns)
        portrait : [Lcd] over [LeftPad | RightPad]
      Button Tag = MIDP key code(s); "a,b" presses several keys (diagonals).
    -->
    <Grid x:Name="Root" SizeChanged="OnSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="Row0" Height="*"/>
            <RowDefinition x:Name="Row1" Height="0"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="Col0" Width="*"/>
            <ColumnDefinition x:Name="Col1" Width="Auto"/>
            <ColumnDefinition x:Name="Col2" Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MIDlet LCD inside its area (background color, gravity, scaling: MainPage::UpdateLcdLayout).
             Touch is mapped to LCD coordinates. -->
        <Border x:Name="LcdHost" Grid.Column="1" SizeChanged="LcdHost_SizeChanged">
            <!-- Direct3D swap chain (LcdPanel), sized to the LCD picture by UpdateLcdLayout -->
            <SwapChainPanel x:Name="LcdImage" HorizontalAlignment="Center" VerticalAlignment="Center"
                   PointerPressed="Lcd_PointerPressed" PointerMoved="Lcd_PointerMoved" PointerReleased="Lcd_PointerReleased"/>
        </Border>

        <TextBlock x:Name="StatusText" Grid.ColumnSpan="3" Margin="8,4" FontSize="11" Foreground="#88FFFFFF"
                   TextWrapping="Wrap" VerticalAlignment="Top" IsHitTestVisible="False"/>
        <TextBlock x:Name="FpsText" Grid.ColumnSpan="3" Margin="8,4" FontSize="14" Foreground="#FF00FF00"
                   HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"/>

        <!-- Left pad: soft keys + 8-way d-pad + fire -->
        <Grid x:Name="LeftPad" Grid.Column="0" Margin="6" VerticalAlignment="Center" MaxHeight="360">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.7*"/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Grid.Column="0" Content="L" Tag="-6" Style="{StaticResource PadKey}"/>
            <Button Grid.Row="0" Grid.Column="1" Content="&#x2630;" x:Name="MenuButton" Style="{StaticResource PadKey}" FontSize="16"
                    Flyout="{StaticResource GameMenu}"/>
            <Button Grid.Row="0" Grid.Column="2" Content="R" Tag="-7" Style="{StaticResource PadKey}"/>
            <Button Grid.Row="1" Grid.Column="0" Content="&#x2196;" Tag="-1,-3" Style="{StaticResource PadKey}"/>
            <Button Grid.Row="1" Grid.Column="1" Content="&#x2191;" Tag="-1" Style="{StaticResource PadKey}"/>
            <Button Grid.Row="1" Grid.Column="2" Content="&#x2197;" Tag="-1,-4" Style="{StaticResource PadKey}"/>
            <Button Grid.Row="2" Grid.Column="0" Content="&#x2190;" Tag="-3" Style="{StaticResource PadKey}"/>
            <Button Grid.Row="2" Grid.Column="1" Content="F" Tag="-5" Style="{StaticResource PadKey}"/>
            <Button Grid.Row="2" Grid.Column="2" Content="&#x2192;" Tag="-4" Style="{StaticResource PadKey}"/>
            <Button Grid.Row="3" Grid.Column="0" Content="&#x2199;" Tag="-2,-3" Style="{StaticResource PadKey}"/>
            <Button Grid.Row="3" Grid.Column="1" Content="&#x2193;" Tag="-2" Style="{StaticResource PadKey}"/>
            <Button Grid.Row="3" Grid.Column="2" Content="&#x2198;" Tag="-2,-4" Style="{StaticResource PadKey}"/>
        </Grid>

        <!-- Right pad: numeric keypad -->
        <Grid x:Name="RightPad" Grid.Column="2" Margin="6" VerticalAlignment="Center" MaxHeight="360">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Grid.Column="0" Content="1" Tag="49" Style="{StaticResource PadKey}"/>
            <Button Grid.Row="0" Grid.Column="1" Content="2" Tag="50" Style="{StaticResource PadKey}"/>
            <Button Grid.Row="0" Grid.Column="2" Content="3" Tag="51" Style="{StaticResource PadKey}"/>
            <Button Grid.Row="1" Grid.Column="0" Content="4" Tag="52" Style="{StaticResource PadKey}"/>
            <Button Grid.Row="1" Grid.Column="1" Content="5" Tag="53" Style="{StaticResource PadKey}"/>
            <Button Grid.Row="1" Grid.Column="2" Content="6" Tag="54" Style="{StaticResource PadKey}"/>
            <Button Grid.Row="2" Grid.Column="0" Content="7" Tag="55" Style="{StaticResource PadKey}"/>
            <Button Grid.Row="2" Grid.Column="1" Content="8" Tag="56" Style="{StaticResource PadKey}"/>
            <Button Grid.Row="2" Grid.Column="2" Content="9" Tag="57" Style="{StaticResource PadKey}"/>
            <Button Grid.Row="3" Grid.Column="0" Content="*" Tag="42" Style="{StaticResource PadKey}"/>
            <Button Grid.Row="3" Grid.Column="1" Content="0" Tag="48" Style="{StaticResource PadKey}"/>
            <Button Grid.Row="3" Grid.Column="2" Content="#" Tag="35" Style="{StaticResource PadKey}"/>
        </Grid>

        <!-- Keypad hidden: small translucent menu button so settings stay reachable. -->
        <Button x:Name="FloatMenuButton" Grid.ColumnSpan="3" Grid.RowSpan="2" Content="&#x2630;"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Width="44" Height="44" Padding="0"
                FontSize="18" Foreground="White" Background="#44000000" BorderBrush="#66FFFFFF" BorderThickness="1"
                Opacity="0.6" Visibility="Collapsed" Flyout="{StaticResource GameMenu}"/>

        <!-- "Move keypad" mode: drag anywhere to move both pads up/down; Done saves. -->
        <Grid x:Name="PadEditOverlay" Grid.ColumnSpan="3" Grid.RowSpan="2" Background="#55000000"
              Visibility="Collapsed"
              PointerPressed="PadEdit_PointerPressed" PointerMoved="PadEdit_PointerMoved"
              PointerReleased="PadEdit_PointerReleased" PointerCanceled="PadEdit_PointerReleased"
              PointerCaptureLost="PadEdit_PointerReleased">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Background="#CC202020" Padding="16,10">
                <TextBlock Text="Drag up / down to move the keypad" Foreground="White" FontSize="16"
                           HorizontalAlignment="Center"/>
                <Button Content="Done" Click="PadEditDone_Click" HorizontalAlignment="Center" Margin="0,10,0,0"
                        MinWidth="100"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
