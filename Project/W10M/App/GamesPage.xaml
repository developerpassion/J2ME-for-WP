<Page
    x:Class="J2MEW10M.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Background="#FF262626">
            <Grid Margin="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Text="J2ME Windows 10 Mobile" FontSize="22" Foreground="White"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <!-- Select several games (to delete them together). -->
                <Button x:Name="SelectButton" Grid.Column="1" Content="&#x2610;" FontSize="20" Foreground="White"
                        Background="Transparent" ToolTipService.ToolTip="Select" Click="SelectButton_Click"/>
                <Button Grid.Column="3" Content="&#x2139;" FontSize="20" Foreground="White" Background="Transparent"
                        ToolTipService.ToolTip="About" Click="AboutButton_Click"/>
                <Button x:Name="SortButton" Grid.Column="2" Content="&#x21C5;" FontSize="20" Foreground="White"
                        Background="Transparent" ToolTipService.ToolTip="Sort">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="By name" Click="SortByName_Click"/>
                            <MenuFlyoutItem Text="Recently added" Click="SortByDate_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <ListView x:Name="GameList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="GameList_ItemClick" SelectionChanged="GameList_SelectionChanged">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="12,0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Height="72" Background="Transparent" RightTapped="Item_RightTapped" Tag="{Binding Id}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" HorizontalAlignment="Left">
                            <Image Source="{Binding Icon}" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="18" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Vendor}" FontSize="13" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Version}" FontSize="13" Opacity="0.6"
                                   VerticalAlignment="Bottom" Margin="8,0,0,10"/>
                        <!-- Settings without starting the game (also: hold / right-click the item). -->
                        <Button Grid.Column="3" Content="&#x2699;" Tag="{Binding Id}" Click="ItemSettings_Click"
                                Width="44" Height="44" Margin="6,0,0,0" Padding="0" FontSize="20"
                                Background="Transparent" BorderThickness="0" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" Margin="24" Opacity="0.7" FontSize="16"
                   Text="No games yet.&#x0a;Tap + to add a .jar file (optionally with its .jad)."/>

        <TextBlock x:Name="StatusText" Grid.Row="1" VerticalAlignment="Bottom" Margin="16,0,96,28"
                   TextWrapping="Wrap" FontSize="13" Opacity="0.8"/>

        <!-- Floating add button -->
        <Grid x:Name="AddButton" Grid.Row="1" Width="60" Height="60" Margin="0,0,24,24"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Tapped="AddButton_Tapped">
            <Ellipse Fill="#FFE91E63"/>
            <TextBlock Text="+" FontSize="32" Foreground="White" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Margin="0,-4,0,0"/>
        </Grid>

        <!-- Selection mode actions -->
        <Border x:Name="SelectBar" Grid.Row="2" Background="#FF262626" Visibility="Collapsed">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SelectCountText" Foreground="White" VerticalAlignment="Center" FontSize="15"/>
                <Button Grid.Column="1" Content="All" Margin="6,0" Click="SelectAll_Click"/>
                <Button x:Name="DeleteSelectedButton" Grid.Column="2" Content="Remove" Margin="6,0"
                        Background="#FFC62828" Foreground="White" Click="DeleteSelected_Click" IsEnabled="False"/>
                <Button Grid.Column="3" Content="Cancel" Margin="6,0,0,0" Click="SelectCancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>
