<ContentDialog
    x:Class="J2MEW10M.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Save"
    SecondaryButtonText="Cancel"
    FullSizeDesired="True">
    <ContentDialog.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Field" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,8">
            <TextBlock Text="Screen options" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,8"/>

            <!-- Width x Height with presets and swap -->
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PresetButton" Grid.Column="0" Content="&#x2630;" Margin="0,0,8,0"
                        Background="Transparent" Foreground="#E91E63" FontSize="20">
                    <Button.Flyout>
                        <MenuFlyout x:Name="PresetMenu"/>
                    </Button.Flyout>
                </Button>
                <TextBox x:Name="WidthBox" Grid.Column="1" InputScope="Number" TextAlignment="Center"/>
                <Button x:Name="SwapButton" Grid.Column="2" Content="&#x21C4;" Margin="6,0" Click="SwapButton_Click"
                        Background="Transparent" Foreground="#E91E63" FontSize="20"/>
                <TextBox x:Name="HeightBox" Grid.Column="3" InputScope="Number" TextAlignment="Center"/>
            </Grid>
            <TextBlock Text="Changing the screen size restarts the game." FontSize="12" Opacity="0.6" Margin="0,0,0,4"/>

            <CheckBox x:Name="KeepAspectBox" Content="Keep aspect ratio"/>

            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Background" Style="{StaticResource Label}"/>
                <TextBox x:Name="BackgroundBox" Grid.Column="1" TextAlignment="Center" MaxLength="6"
                         TextChanged="BackgroundBox_TextChanged"/>
                <Border x:Name="BackgroundSwatch" Grid.Column="2" Width="40" Height="32" Margin="8,0,0,0"
                        BorderBrush="Gray" BorderThickness="1"/>
            </Grid>

            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Scale (%)" Style="{StaticResource Label}"/>
                <TextBox x:Name="ScaleBox" Grid.Row="0" Grid.Column="1" InputScope="Number" TextAlignment="Center" Style="{StaticResource Field}"/>

                <TextBlock Grid.Row="1" Text="Screen orientation" Style="{StaticResource Label}"/>
                <ComboBox x:Name="OrientationBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}">
                    <x:String>Default</x:String>
                    <x:String>Portrait</x:String>
                    <x:String>Landscape</x:String>
                </ComboBox>

                <TextBlock Grid.Row="2" Text="Screen gravity" Style="{StaticResource Label}"/>
                <ComboBox x:Name="GravityBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}">
                    <x:String>Top</x:String>
                    <x:String>Center</x:String>
                    <x:String>Bottom</x:String>
                </ComboBox>

                <TextBlock Grid.Row="3" Text="Scale type" Style="{StaticResource Label}"/>
                <ComboBox x:Name="ScaleTypeBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource Field}">
                    <x:String>Fit to window</x:String>
                    <x:String>Stretch</x:String>
                    <x:String>Integer scale</x:String>
                    <x:String>Original size</x:String>
                </ComboBox>

                <TextBlock Grid.Row="4" Text="Limit FPS" Style="{StaticResource Label}"/>
                <TextBox x:Name="LimitFpsBox" Grid.Row="4" Grid.Column="1" InputScope="Number" TextAlignment="Center"
                         PlaceholderText="unlimited" Style="{StaticResource Field}"/>
            </Grid>

            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Java heap (MB)" Style="{StaticResource Label}"/>
                <ComboBox x:Name="HeapBox" Grid.Column="1" Style="{StaticResource Field}">
                    <x:String>64</x:String>
                    <x:String>96</x:String>
                    <x:String>128</x:String>
                    <x:String>192</x:String>
                    <x:String>256</x:String>
                </ComboBox>
            </Grid>
            <TextBlock Text="Raise it when a game reports out of memory. Applies on the next game start." FontSize="12" Opacity="0.6" Margin="0,0,0,4" TextWrapping="Wrap"/>

            <ToggleSwitch x:Name="FilterSwitch" Header="Filter (smooth scaling)"/>
            <ToggleSwitch x:Name="ShowFpsSwitch" Header="Show FPS"/>
            <ToggleSwitch x:Name="ShowTitleSwitch" Header="Show game name"/>
            <ToggleSwitch x:Name="KeypadSwitch" Header="Show on-screen keypad"/>

            <Button x:Name="ResetButton" Content="Reset to defaults" Margin="0,12,0,0" Click="ResetButton_Click"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
