    <WholeProgramOptimization>true</WholeProgramOptimization>
    <UseDotNetNativeToolchain>false</UseDotNetNativeToolchain>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="..\..\Shared\props\Common.props" />
  </ImportGroup>
  <PropertyGroup>
    <OutDir>$(SolutionDir)bin\$(Platform)\$(Configuration)\$(ProjectName)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
    <!-- ARM: no incremental link. ILT thunks are Thumb (b.w) and cannot reach the ARM-mode interpreter. -->
    <LinkIncremental Condition="'$(Platform)'=='ARM'">false</LinkIncremental>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <AppxBundle Condition="'$(Configuration)|$(Platform)'=='Release|ARM'">Always</AppxBundle>
    <AppxBundle Condition="'$(Configuration)|$(Platform)'!='Release|ARM'">Never</AppxBundle>
    <AppxBundlePlatforms>arm</AppxBundlePlatforms>
    <AppInstallerUpdateFrequency>1</AppInstallerUpdateFrequency>
    <AppInstallerCheckForUpdateFrequency>OnApplicationRun</AppInstallerCheckForUpdateFrequency>
    <AppxBundle>Auto</AppxBundle>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <AdditionalOptions>/bigobj /utf-8 %(AdditionalOptions)</AdditionalOptions>
      <DisableSpecificWarnings>4453;28204</DisableSpecificWarnings>
      <PreprocessorDefinitions>J2MEWP_W10M=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <!-- mincore (SDK 10586): FlushInstructionCache etc. for the JIT, bound to API sets instead of kernel32.dll
           (a direct kernel32.dll import fails to load on W10M 10586: 0xC0000135). ws2_32: VM sockets. -->
      <AdditionalDependencies>$(IntDir)memory_l1_1_3.lib;$(WindowsSdkDir)Lib\10.0.10586.0\um\$(PlatformTarget)\mincore.lib;ws2_32.lib;dwrite.lib;d3d11.lib;dxgi.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- ROMImage AOT code (_rom_text_block*, see Shared/host/rom_exec_section.h) must be executable. -->
      <AdditionalOptions Condition="'$(Platform)'=='ARM'">/SECTION:.romtx,ER %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
