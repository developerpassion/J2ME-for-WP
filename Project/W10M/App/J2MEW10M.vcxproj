  <PropertyGroup Label="Globals">
    <ProjectGuid>{6F1C2B3A-7D44-4E59-9A21-0C3B5E8D1A02}</ProjectGuid>
    <RootNamespace>J2MEW10M</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <MinimumVisualStudioVersion>15.0</MinimumVisualStudioVersion>
    <AppContainerApplication>true</AppContainerApplication>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <WindowsTargetPlatformVersion>10.0.15063.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.10586.0</WindowsTargetPlatformMinVersion>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
  </PropertyGroup>
  <!-- Sideload signing (CN=J2MEWP, matches the manifest Publisher). The key and its
       password are local only (gitignored): Signing\J2MEWP_Sideload.pfx +
       Signing\Signing.local.props. Without them the package is built unsigned. -->
  <Import Project="Signing\Signing.local.props" Condition="Exists('Signing\Signing.local.props')" />
  <!-- MSBuild's own signing (VS2017) cannot open a password-protected .pfx (APPX0105)
       unless it is imported into the cert store, so the package is built unsigned and
       then signed with signtool (J2MEWPSignPackage below). -->
  <PropertyGroup>
    <J2MEWPSignTool>$(MSBuildProgramFiles32)\Windows Kits\10\bin\10.0.17763.0\x86\signtool.exe</J2MEWPSignTool>
    <J2MEWPSignCmd>"$(J2MEWPSignTool)" sign /q /fd SHA256 /f "$(PackageCertificateKeyFile)" /p "$(PackageCertificatePassword)"</J2MEWPSignCmd>
  </PropertyGroup>
  <!-- inner .appx (also the final package when no bundle is produced) -->
  <Target Name="J2MEWPSignMainPackage" AfterTargets="_CreateMainPackage" Condition="Exists('$(PackageCertificateKeyFile)') and Exists('$(AppxMainPackageOutput)')">
    <Exec Command="$(J2MEWPSignCmd) &quot;$(AppxMainPackageOutput)&quot;" EchoOff="true" />
    <Message Importance="high" Text="Signed $(AppxMainPackageOutput)" />
  </Target>
  <Target Name="J2MEWPSignBundle" AfterTargets="_CreateBundle" Condition="Exists('$(PackageCertificateKeyFile)') and Exists('$(AppxBundleOutput)')">
    <Exec Command="$(J2MEWPSignCmd) &quot;$(AppxBundleOutput)&quot;" EchoOff="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Signing\J2MEWP_Sideload.cer" DestinationFolder="$(AppxPackageTestDir)" />
    <Message Importance="high" Text="Signed $(AppxBundleOutput)" />
  </Target>
  <!-- No bundle (AppxBundle Never/Auto with one platform): the .appx is written
       straight to the _Test folder without going through _CreateMainPackage. -->
  <Target Name="J2MEWPCopyCer" AfterTargets="_CreateAppxPackage" Condition="Exists('$(PackageCertificateKeyFile)') and '$(AppxPackageTestDir)' != '' and Exists('$(AppxPackageTestDir)')">
    <Exec Condition="'$(AppxPackageOutput)' != '' and Exists('$(AppxPackageOutput)') and '$(ProduceAppxBundle)' != 'true'" Command="$(J2MEWPSignCmd) &quot;$(AppxPackageOutput)&quot;" EchoOff="true" />
    <Message Condition="'$(AppxPackageOutput)' != '' and Exists('$(AppxPackageOutput)') and '$(ProduceAppxBundle)' != 'true'" Importance="high" Text="Signed $(AppxPackageOutput)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Signing\J2MEWP_Sideload.cer" DestinationFolder="$(AppxPackageTestDir)" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v141</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
