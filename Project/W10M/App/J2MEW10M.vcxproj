  <!-- Import lib for memory_l1_1_3.def (10586-compatible VirtualAllocFromApp/VirtualProtectFromApp). -->
  <Target Name="BuildMemoryL113Lib" BeforeTargets="ClCompile;Link" Inputs="$(MSBuildThisFileDirectory)memory_l1_1_3.def" Outputs="$(IntDir)memory_l1_1_3.lib">
