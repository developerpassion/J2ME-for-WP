<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">
  <Identity Name="J2MEWP.W10M" Publisher="CN=J2MEWP" Version="0.0.1.0" />
  <mp:PhoneIdentity PhoneProductId="6f1c2b3a-7d44-4e59-9a21-0c3b5e8d1a03" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>
  <Properties>
    <DisplayName>J2ME Windows 10 Mobile</DisplayName>
    <PublisherDisplayName>J2MEWP</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.10586.0" MaxVersionTested="10.0.15063.0" />
  </Dependencies>
  <Resources>
    <Resource Language="x-generate"/>
  </Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="J2MEW10M.App">
      <uap:VisualElements DisplayName="J2ME Windows 10 Mobile" Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png" Description="J2ME (MIDP 2.0) game runner" BackgroundColor="#525BA0">
        <!-- Tile images already contain "J2ME Windows Phone": no name overlay. -->
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="J2ME WP" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#525BA0" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <!-- codeGeneration: cho phep JIT (MapViewOfFileFromApp/VirtualProtectFromApp). Can kiem chung (W3.3). -->
    <Capability Name="codeGeneration" />
  </Capabilities>
</Package>
