<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM"><Configuration>Debug</Configuration><Platform>ARM</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Debug|Win32"><Configuration>Debug</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM"><Configuration>Release</Configuration><Platform>ARM</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32"><Configuration>Release</Configuration><Platform>Win32</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{6F1C2B3A-7D44-4E59-9A21-0C3B5E8D1A01}</ProjectGuid>
    <RootNamespace>JvmCore</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <MinimumVisualStudioVersion>15.0</MinimumVisualStudioVersion>
    <AppContainerApplication>true</AppContainerApplication>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <WindowsTargetPlatformVersion>10.0.15063.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.10586.0</WindowsTargetPlatformMinVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <PlatformToolset>v141</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <GenerateWindowsMetadata>false</GenerateWindowsMetadata>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="..\..\Shared\props\Common.props" />
    <!-- J2MEWPStack: midp (default) = CLDC VM + pcsl + MIDP + javacall_winphone (gen_midp_sources.py)
                       cldc            = CLDC VM only, plain main() classes (gen_jvmcore_sources.py) -->
    <Import Project="..\..\Shared\jvm\midp_x86.props" Condition="'$(Platform)'=='Win32' And '$(J2MEWPStack)'!='cldc'" />
    <Import Project="..\..\Shared\jvm\cldc_vm_x86.props" Condition="'$(Platform)'=='Win32' And '$(J2MEWPStack)'=='cldc'" />
    <Import Project="..\..\Shared\jvm\midp_arm.props" Condition="'$(Platform)'=='ARM' And '$(J2MEWPStack)'!='cldc'" />
  </ImportGroup>
  <PropertyGroup>
    <OutDir>$(SolutionDir)bin\$(Platform)\$(Configuration)\$(ProjectName)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Lib><GenerateWindowsMetadata>false</GenerateWindowsMetadata></Lib>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <CompileAsWinRT>false</CompileAsWinRT>
      <SDLCheck>false</SDLCheck>
      <PreprocessorDefinitions>J2MEWP_W10M=1;J2MEWP_ENABLE_JIT=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <MASM>
      <UseSafeExceptionHandlers>true</UseSafeExceptionHandlers>
    </MASM>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile><PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile><Optimization>MaxSpeed</Optimization><PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
  </ItemDefinitionGroup>
  <!-- ARM: C/C++ is Thumb, the interpreter asm is ARM; calls into it go through
       Thumb thunks (generated by Project/tools/gen_arm_softfp.py). -->
  <ItemDefinitionGroup Condition="'$(Platform)'=='ARM'">
    <ClCompile>
      <ForcedIncludeFiles>$(J2MESharedDir)host\arm_thumb_calls.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup Condition="'$(Platform)'=='ARM'">
    <ClInclude Include="..\..\Shared\host\arm_thumb_calls.h" />
    <MARMASM Include="..\..\Shared\host\arm_thumb_thunks.asm" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\..\Shared\host\jvm_host.h" />
    <ClCompile Include="..\..\Shared\host\jvm_host.cpp" />
    <ClCompile Include="..\..\Shared\host\jar_manifest.c">
      <AdditionalIncludeDirectories>$(PhoneMERoot)midp\src\core\jarutil\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\masm.targets" Condition="'$(Platform)'!='ARM'" />
    <Import Project="$(VCTargetsPath)\BuildCustomizations\marmasm.targets" Condition="'$(Platform)'=='ARM'" />
  </ImportGroup>
</Project>
