<?xml version="1.0" encoding="utf-8"?>
<Deployment xmlns="http://schemas.microsoft.com/windowsphone/2012/deployment" AppPlatformVersion="8.0">
  <DefaultLanguage xmlns="" code="en-US" />
  <App xmlns="" ProductID="{3D8F1A62-7C4B-4E95-A1D0-5B2E9F6C7A80}" Title="J2ME Windows Phone 8" RuntimeType="Silverlight"
       Version="0.0.1.0" Genre="apps.normal" Author="J2MEWP" Description="Runs J2ME (MIDP 2.0) games" Publisher="J2MEWP"
       PublisherID="{1B4C8E2D-7A39-4F60-9D15-6E2A8C3B7D81}">
    <IconPath IsRelative="true" IsResource="false">Assets\ApplicationIcon.png</IconPath>
    <Capabilities>
      <Capability Name="ID_CAP_NETWORKING" />
      <Capability Name="ID_CAP_REMOVABLE_STORAGE" />
      <Capability Name="ID_CAP_MEDIALIB_AUDIO" />
      <Capability Name="ID_CAP_MEDIALIB_PLAYBACK" />
    </Capabilities>
    <Tasks>
      <DefaultTask Name="_default" NavigationPage="MainPage.xaml" />
    </Tasks>
    <Tokens>
      <PrimaryToken TokenID="J2MEWP80Token" TaskName="_default">
        <TemplateFlip>
          <SmallImageURI IsRelative="true" IsResource="false">Assets\Tiles\FlipCycleTileSmall.png</SmallImageURI>
          <Count>0</Count>
          <BackgroundImageURI IsRelative="true" IsResource="false">Assets\Tiles\FlipCycleTileMedium.png</BackgroundImageURI>
          <Title>J2ME</Title>
          <BackContent></BackContent>
          <BackBackgroundImageURI></BackBackgroundImageURI>
          <BackTitle></BackTitle>
          <DeviceLockImageURI></DeviceLockImageURI>
          <HasLarge>false</HasLarge>
        </TemplateFlip>
      </PrimaryToken>
    </Tokens>
    <!-- .jar / .jad: open from email / browser / OneDrive, and list them on the SD card (ExternalStorage) -->
    <Extensions>
      <FileTypeAssociation TaskID="_default" Name="j2me" NavUriFragment="fileToken=%s">
        <Logos>
          <Logo Size="small" IsRelative="true">Assets/FileJar33.png</Logo>
          <Logo Size="medium" IsRelative="true">Assets/FileJar69.png</Logo>
          <Logo Size="large" IsRelative="true">Assets/FileJar176.png</Logo>
        </Logos>
        <SupportedFileTypes>
          <FileType ContentType="application/java-archive">.jar</FileType>
          <FileType ContentType="text/vnd.sun.j2me.app-descriptor">.jad</FileType>
        </SupportedFileTypes>
      </FileTypeAssociation>
    </Extensions>
    <!-- C++ component (Runtime/J2MEWPRuntime.vcxproj) -->
    <ActivatableClasses>
      <InProcessServer>
        <Path>J2MEWPRuntime.dll</Path>
        <ActivatableClass ActivatableClassId="J2MEWPRuntime.Core" ThreadingModel="both" />
        <ActivatableClass ActivatableClassId="J2MEWPRuntime.GameEntry" ThreadingModel="both" />
        <ActivatableClass ActivatableClassId="J2MEWPRuntime.GameSettings" ThreadingModel="both" />
        <ActivatableClass ActivatableClassId="J2MEWPRuntime.LcdSurface" ThreadingModel="both" />
      </InProcessServer>
    </ActivatableClasses>
    <ScreenResolutions>
      <ScreenResolution Name="ID_RESOLUTION_WVGA" />
      <ScreenResolution Name="ID_RESOLUTION_WXGA" />
      <ScreenResolution Name="ID_RESOLUTION_HD720P" />
    </ScreenResolutions>
  </App>
</Deployment>
