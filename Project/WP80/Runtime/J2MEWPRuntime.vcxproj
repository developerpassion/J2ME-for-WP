<?xml version="1.0" encoding="utf-8"?>
<!--
  J2MEWP: Windows Phone Runtime component (C++/CX) for the WP 8.0 app.
  Same sources as WP81/Runtime (Core.{h,cpp}) plus the W10M AppState / audio /
  vibration code. WP8.0 differences: no DirectWrite (FontEngine80.cpp stub ->
  MIDP bitmap font), no Media Foundation source reader (no MP3/AMR).
  Toolset: VS2012 v110_wp80 through MSBuild 14, ARM only.
-->
<Project DefaultTargets="Build" ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM"><Configuration>Debug</Configuration><Platform>ARM</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM"><Configuration>Release</Configuration><Platform>ARM</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{6F1C2B3A-7D44-4E59-9A21-0C3B5E8D1A83}</ProjectGuid>
    <RootNamespace>J2MEWPRuntime</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <MinimumVisualStudioVersion>11.0</MinimumVisualStudioVersion>
    <WinMDAssembly>true</WinMDAssembly>
  </PropertyGroup>
  <PropertyGroup Condition="'$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &gt;= '11.0'">
    <VCTargetsPath Condition="'$(VCTargetsPath11)' != '' and '$(VSVersion)' == '' and '$(VisualStudioVersion)' == ''">$(VCTargetsPath11)</VCTargetsPath>
  </PropertyGroup>
  <PropertyGroup>
    <TargetPlatformIdentifier>Windows Phone</TargetPlatformIdentifier>
    <TargetPlatformVersion>8.0</TargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v110_wp80</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <!-- Debug also uses the release CRT: WP8.0 phones have no MSVCR110D / vccorlib110d -->
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="..\..\Shared\props\Common.props" />
  </ImportGroup>
  <PropertyGroup>
    <GenerateManifest>false</GenerateManifest>
    <OutDir>$(SolutionDir)bin\$(Platform)\$(Configuration)\$(ProjectName)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
    <!-- ARM: no incremental link (ILT thunks are Thumb and cannot reach the ARM-mode interpreter). -->
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <CompileAsWinRT>true</CompileAsWinRT>
      <SDLCheck>false</SDLCheck>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <AdditionalOptions>/bigobj %(AdditionalOptions)</AdditionalOptions>
      <DisableSpecificWarnings>4453;28204;4819</DisableSpecificWarnings>
      <PreprocessorDefinitions>J2MEWP_WP81=1;J2MEWP_WP80=1;_WINRT_DLL;NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\WP81\Runtime;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalUsingDirectories>$(WindowsSDK_MetadataPath);$(AdditionalUsingDirectories)</AdditionalUsingDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateWindowsMetadata>true</GenerateWindowsMetadata>
      <GenerateMapFile>true</GenerateMapFile>
      <IgnoreSpecificDefaultLibraries>ole32.lib;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
      <AdditionalDependencies>WindowsPhoneCore.lib;RuntimeObject.lib;PhoneAppModelHost.lib;d3d11.lib;ws2_32.lib;xaudio2.lib;$(SolutionDir)bin\$(Platform)\$(Configuration)\JvmCore\JvmCore.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- ROMImage AOT code (_rom_text_block*, see Shared/host/rom_exec_section.h) must be executable. -->
      <AdditionalOptions>/SECTION:.romtx,ER %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile><Optimization>Disabled</Optimization></ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile><Optimization>MaxSpeed</Optimization></ClCompile>
  </ItemDefinitionGroup>
  <!-- /ZW on VS2012: Windows + platform metadata (as Ruffle's RuffleWP80Native) -->
  <ItemGroup>
    <Reference Include="Windows"><IsWinMDFile>true</IsWinMDFile></Reference>
    <Reference Include="platform.winmd"><IsWinMDFile>true</IsWinMDFile><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\..\WP81\Runtime\pch.h" />
    <ClInclude Include="..\..\WP81\Runtime\Core.h" />
    <ClCompile Include="..\..\WP81\Runtime\Core.cpp" />
    <ClInclude Include="..\..\WP81\Runtime\LcdSurface.h" />
    <ClCompile Include="..\..\WP81\Runtime\LcdSurface.cpp" />
    <ClInclude Include="..\..\Shared\render\lcd_renderer.h" />
    <ClCompile Include="..\..\Shared\render\lcd_renderer.cpp">
      <CompileAsWinRT>false</CompileAsWinRT>
    </ClCompile>
    <ClCompile Include="..\..\W10M\App\AppState.cpp" />
    <ClCompile Include="..\..\W10M\App\AudioEngine.cpp" />
    <ClCompile Include="..\..\W10M\App\DeviceEngine.cpp" />
    <ClCompile Include="..\FontEngine80.cpp">
      <CompileAsWinRT>false</CompileAsWinRT>
    </ClCompile>
    <ClCompile Include="..\..\Shared\host\game_library.cpp">
      <CompileAsWinRT>false</CompileAsWinRT>
    </ClCompile>
    <ClCompile Include="..\..\Shared\audio\midi_synth.cpp">
      <CompileAsWinRT>false</CompileAsWinRT>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JvmCore\JvmCore.vcxproj">
      <Project>{6F1C2B3A-7D44-4E59-9A21-0C3B5E8D1A80}</Project>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
