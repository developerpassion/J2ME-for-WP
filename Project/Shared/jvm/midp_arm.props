  <!-- link.exe treats armasm B/BL relocations as Thumb and routes ARM code through Thumb
       thunks/ILT (crash C000001D on the phone). Resolve internal branches in the obj. -->
  <Target Name="J2MEWPPatchArmObj" AfterTargets="_MARMASM" Condition="'$(Platform)'=='ARM'">
    <Exec Command="python3 &quot;$(J2MESharedDir)..\tools\patch_arm_obj.py&quot; &quot;$(IntDir)Interpreter_arm.obj&quot;" />
  </Target>
