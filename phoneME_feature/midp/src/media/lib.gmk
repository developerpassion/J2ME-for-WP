# J2MEWP: vendor API stubs (Nokia S40 touch, Samsung, Siemens, Motorola): no-op
#         light/vibration, Samsung AudioClip + Siemens Sound use javax.microedition.media
# J2MEWP: java.lang.StringBuilder (games compiled with javac 1.5+ use it for string concatenation)
# J2MEWP: JSR 120 stub (javax.wireless.messaging + sms:/cbs: protocols, no real SMS)
# J2MEWP: Nokia UI API (com.nokia.mid.ui, com.nokia.mid.sound), pure Java on MIDP 2.0
# J2MEWP: JSR 82 / JSR 75 / JSR 184 API stubs (no Bluetooth, no file roots, M3G draws nothing)

# J2MEWP: natives of AudioPlayer -> host audio backend (j2mewp_audio.h)
vpath % $(SUBSYSTEM_DIR)/media/reference/native
SUBSYSTEM_MEDIA_EXTRA_INCLUDES += -I$(SUBSYSTEM_DIR)/media/include
SUBSYSTEM_MEDIA_NATIVE_FILES += j2mewp_media_kni.c

# Native files for the ( media ) subsystem
#
#####  no native sources for media, therefore empty

